{
  "name": "pmos-agent-mgmt",
  "version": "1.0.0",
  "description": "PMOS Agent Management Service",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app/main.js",
    "dev": "ts-node app/main.ts",
    "test": "jest --config tests/jest.config.ts --coverage",
    "test:unit": "jest --config tests/jest.config.ts --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --config tests/jest.config.ts --testPathPattern=tests/integration --coverage"
  },
  "dependencies": {
    "express": "^5.0.0",
    "mysql2": "^3.7.1",
    "ioredis": "^5.3.2",
    "axios": "^1.6.7",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "prom-client": "^15.1.0",
    "dotenv": "^16.4.1",
    "neo4j-driver": "^5.17.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^5.0.0",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
