{
  "name": "pmos-gateway",
  "version": "1.0.0",
  "description": "PMOS API Gateway — inbound HTTP, JWT auth, rate limiting, WebSocket streaming",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node app/main.ts",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration --coverage",
    "lint": "eslint 'app/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.3.2",
    "axios": "^1.6.7",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "ws": "^8.16.0",
    "prom-client": "^15.1.0",
    "dotenv": "^16.4.1",
    "http-proxy-middleware": "^3.0.0",
    "mysql2": "^3.11.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.11.5",
    "@types/bcryptjs": "^2.4.6",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "nock": "^13.5.0",
    "@types/nock": "^11.1.0"
  }
}
