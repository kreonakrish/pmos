# =============================================================================
# PMOS - Environment Variable Template
# Copy this file to .env and fill in all values marked REQUIRED
# Never commit .env to version control
# =============================================================================

# =============================================================================
# LLM PROVIDER
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
OPENAI_API_KEY=                    # REQUIRED
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# NEO4J - AuraDB Cloud (TLS encrypted, no local container needed)
# =============================================================================
NEO4J_URI=neo4j+s://8414810d.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=                    # REQUIRED
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SEC=30

# =============================================================================
# MYSQL - Local Docker (root user)
# =============================================================================
MYSQL_HOST=host-gateway
MYSQL_PORT=3306
MYSQL_DB=pmos
MYSQL_USER=root
MYSQL_PASSWORD=                    # REQUIRED
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=10
MYSQL_CONNECT_TIMEOUT=10

# =============================================================================
# REDIS - Local Docker (redis:7.2)
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=100
REDIS_SHORT_TERM_TTL_SEC=3600
REDIS_STREAM_MAX_LEN=10000

# =============================================================================
# VECTOR STORE - Qdrant (self-hosted Docker, qdrant/qdrant:v1.9.0)
# UI available at http://localhost:6333/dashboard after startup
# =============================================================================
VECTOR_STORE_BACKEND=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=pmos
QDRANT_PREFER_GRPC=true

# =============================================================================
# EMBEDDINGS
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FAISS_INDEX_PATH=/data/faiss

# =============================================================================
# SERVICE PORTS
# =============================================================================
GATEWAY_PORT=4000
AGENT_MGMT_PORT=4001
ORCHESTRATOR_PORT=8000
MEMORY_PORT=8001
RAG_PORT=8002
SCORING_PORT=8003
META_ASSEMBLY_PORT=8004

# =============================================================================
# SERVICE-TO-SERVICE URLS (internal Docker network names)
# =============================================================================
ORCHESTRATOR_URL=http://orchestrator:8000
AGENT_MGMT_URL=http://agent-mgmt:4001
MEMORY_SERVICE_URL=http://memory:8001
RAG_SERVICE_URL=http://rag:8002
SCORING_SERVICE_URL=http://scoring:8003
META_ASSEMBLY_URL=http://meta-assembly:8004

# =============================================================================
# GATEWAY / AUTH
# JWT_SECRET: generate with -> openssl rand -hex 64
# =============================================================================
JWT_SECRET=                        # REQUIRED - generate with: openssl rand -hex 64
JWT_EXPIRY_SEC=86400
RATE_LIMIT_RPM=120
API_KEY_HEADER=x-api-key

# -----------------------------------------------------------------------------
# Bootstrap users (seeded on first gateway start; idempotent thereafter)
# Passwords are bcrypted server-side; never stored in SQL.
# -----------------------------------------------------------------------------
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@pmos.local
SUPER_ADMIN_PASSWORD=               # REQUIRED on first boot (min 8 chars)

KRISH_USERNAME=krish
KRISH_EMAIL=krish@pmos.local
KRISH_INITIAL_PASSWORD=             # REQUIRED on first boot; user must change on first login

BCRYPT_ROUNDS=12

# =============================================================================
# ORCHESTRATOR - Retry and Circuit Breaker
# =============================================================================
RETRY_MAX_ATTEMPTS=3
RETRY_STRATEGY=EXPONENTIAL
RETRY_WAIT_MULTIPLIER=1
RETRY_WAIT_MAX_SEC=10
CB_TIMEOUT_SEC=30
MAX_CONCURRENT_LLM_CALLS=10

# =============================================================================
# MEMORY SERVICE
# =============================================================================
SHORT_TERM_TTL_SEC=3600
DISTILLATION_INTERVAL_MIN=30
DISTILLATION_FREQUENCY_THRESHOLD=3

# =============================================================================
# RAG SERVICE
# =============================================================================
RAG_TOP_K=10
RAG_PARALLEL_TIMEOUT_SEC=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# =============================================================================
# SCORING SERVICE
# =============================================================================
SCORING_HISTORY_WINDOW=50
BAND_SENSITIVITY_FACTOR=1.0
BAND_MIN_WIDTH=0.05
RL_LEARNING_RATE=0.1
RL_FEEDBACK_WEIGHTS={"automated":0.4,"user":0.3,"inter_agent":0.2,"orchestrator":0.1}

# =============================================================================
# PERPETUAL AGENTIC LOOP — Phase D ML decision flags
# Both default OFF so existing deployments don't change behavior. The
# selectors carry their own safeguards (bandit auto-downgrades to FALLBACK
# when an arm has < 20 historical pulls; learned-scorer is only blended
# in when w7 > 0), so flipping these on is non-destructive.
# See docs/ML_OPS.md for the full rollout playbook.
# =============================================================================
# When true, the contextual bandit's pick can override the bid winner in
# capability negotiation (only when the picked arm has enough pulls to be
# trusted; otherwise auto-downgraded to FALLBACK and the bid winner stands).
BANDIT_LIVE_SELECTION=false

# Blend weight for the LearnedScorer's prediction:
#     final_score = (1 - w7) * heuristic + w7 * learned
# Typical live values: 0.2-0.3. Set to 0.0 to keep shadow-only logging.
SCORING_WEIGHT_W7_LEARNED=0.0

# =============================================================================
# META-ASSEMBLY SERVICE
# =============================================================================
META_ALLOWED_IMPORTS=requests,json,re,math,datetime,collections,itertools,functools,numpy,pandas
META_SANDBOX_TIMEOUT_SEC=30
META_SANDBOX_MEMORY_MB=256

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9090
OTEL_SERVICE_NAME=pmos

# =============================================================================
# TOOL HEALTH
# =============================================================================
TOOL_HEALTH_INTERVAL_SEC=60

# =============================================================================
# CLIENT (Dockerized React app served by nginx; runtime config injected)
# Leave PMOS_API_BASE_URL / PMOS_WS_BASE_URL empty to use same-origin routing
# (browser hits the nginx in front of the client, which proxies /v1 to gateway).
# Set to absolute URLs only if the client is served from a different origin
# than the gateway (e.g. CDN-hosted SPA + remote API).
# =============================================================================
CLIENT_PORT=3000
PMOS_API_BASE_URL=
PMOS_WS_BASE_URL=
PMOS_ENV=production
